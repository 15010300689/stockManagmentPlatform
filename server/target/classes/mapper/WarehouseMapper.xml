<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stock.mapper.WarehouseMapper">

    <sql id="WarehouseBaseColumns">
        id, code, name, status, address, contact, phone, create_time
    </sql>

    <sql id="WarehouseFilterWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (code LIKE CONCAT('%', #{keyword}, '%') OR name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="findAll" resultType="com.stock.entity.Warehouse">
        SELECT <include refid="WarehouseBaseColumns" /> FROM warehouse ORDER BY id
    </select>

    <select id="findPageByCondition" resultType="com.stock.entity.Warehouse">
        SELECT <include refid="WarehouseBaseColumns" />
        FROM warehouse
        <include refid="WarehouseFilterWhere" />
        ORDER BY id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*)
        FROM warehouse
        <include refid="WarehouseFilterWhere" />
    </select>

    <select id="findById" resultType="com.stock.entity.Warehouse">
        SELECT <include refid="WarehouseBaseColumns" /> FROM warehouse WHERE id = #{id}
    </select>

    <select id="findByCode" resultType="com.stock.entity.Warehouse">
        SELECT <include refid="WarehouseBaseColumns" />
        FROM warehouse
        WHERE code = #{code}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.stock.entity.Warehouse" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO warehouse (code, name, status, address, contact, phone)
        VALUES (#{code}, #{name}, #{status}, #{address}, #{contact}, #{phone})
    </insert>

    <update id="update" parameterType="com.stock.entity.Warehouse">
        UPDATE warehouse
        <set>
            <if test="code != null">code = #{code},</if>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="address != null">address = #{address},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="phone != null">phone = #{phone},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM warehouse WHERE id = #{id}
    </delete>

</mapper>
